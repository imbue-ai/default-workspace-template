      "expected": {"column": 0, "row": 0}
    },
    {
      "name": "a full grid answers the clamped target",
      "target": {"column": 0, "row": 0},
      "occupied": [{"column": 0, "row": 0}, {"column": 1, "row": 0}, {"column": 0, "row": 1}, {"column": 1, "row": 1}],
      "grid": {"columns": 2, "rows": 2},
      "expected": {"column": 0, "row": 0}
    }
  ],
  "shortcut_placement": [
    {
      "name": "stored cells inside the grid are kept, a collision moves the later one",
      "grid": {"columns": 3, "rows": 3},
      "cells": [{"column": 0, "row": 0}, {"column": 0, "row": 0}, {"column": 2, "row": 2}],
      "expected": [{"column": 0, "row": 0}, {"column": 0, "row": 1}, {"column": 2, "row": 2}]
