      "backdrop": {"width": 400, "height": 300},
      "expected": {"x": 0, "y": 0, "width": 320, "height": 240}
    },
    {
      "name": "a narrow window at the right edge grows to the minimum width and keeps the minimum visible title inside",
      "frame": {"x": 0.9, "y": 0.1, "width": 0.1, "height": 0.4},
      "backdrop": {"width": 1000, "height": 800},
      "expected": {"x": 880, "y": 80, "width": 320, "height": 320}
    },
    {
      "name": "a narrow backdrop raises the width past its edge and the title stays inside on the right",
      "frame": {"x": 0.5, "y": 0.1, "width": 0.5, "height": 0.4},
      "backdrop": {"width": 200, "height": 800},
      "expected": {"x": 80, "y": 80, "width": 320, "height": 320}
    },
    {
      "name": "a short window at the bottom grows to the minimum height and keeps its whole title bar inside",
      "frame": {"x": 0.1, "y": 0.97, "width": 0.4, "height": 0.03},
      "backdrop": {"width": 1000, "height": 800},
      "expected": {"x": 100, "y": 764, "width": 400, "height": 240}
    }
