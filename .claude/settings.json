{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/session_start_sync.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/ensure_tk_on_path.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/services/oom_priority/bin/claude_shed_notice_hook.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/system/scripts/claude_background_task_hooks.py session-start || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_prevent_commit_rewrite.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_block_pipe_tail_head.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_block_foreground_sleep.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_latchkey_request_standalone.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_secrets_guard.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_tk_standalone.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_require_steps_pretool.sh"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_rewrite_bash_command.py 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_open_tickets_reminder.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_resource_notice.sh"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_memory_change_log.py sync"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$MNGR_CLAUDE_SUBAGENT_PROXY_CHILD\" ] && exit 0; \"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_open_tickets_stop_nudge.sh"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/system/scripts/claude_background_task_hooks.py stop || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/system/scripts/agent_memory_change_log.py post"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "${MNGR_AGENT_WORK_DIR:-.}/system/scripts/claude_status_line.sh",
    "refreshInterval": 2
  },
  "enabledPlugins": {
    "imbue-code-guardian@imbue-code-guardian": true,
    "frontend-design@claude-code-plugins-pinned": true
  },
  "extraKnownMarketplaces": {
    "imbue-code-guardian": {
      "source": {
        "source": "directory",
        "path": "/opt/agent-plugins/imbue-code-guardian"
      }
    },
    "claude-code-plugins-pinned": {
      "source": {
        "source": "directory",
        "path": "/opt/agent-plugins/claude-code-plugins-pinned"
      }
    }
  },
  "autoMemoryDirectory": "~/workspace/data/memories"
}
