{
  "name": "markdown-editor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "git rev-parse HEAD:./ HEAD:../../../libs/workspace_ui HEAD:../../../package-lock.json > ../src/markdown_editor_app/static/.source-tree-hash 2>/dev/null || rm -f ../src/markdown_editor_app/static/.source-tree-hash",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,css,html}' '*.{ts,html}'",
    "format:check": "prettier --check 'src/**/*.{ts,css,html}' '*.{ts,html}'",
    "test": "vitest run"
  },
  "dependencies": {
    "@handlewithcare/prosemirror-suggest-changes": "^0.1.8",
    "@imbue/workspace-ui": "0.1.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-blockquote": "^3.33.0",
    "@tiptap/extension-document": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.0"
  }
}
