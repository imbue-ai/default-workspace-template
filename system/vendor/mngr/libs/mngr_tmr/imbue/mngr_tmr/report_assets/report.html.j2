{#-
  Top-level template for the TMR HTML report.

  Context variables (built in `report.generate_html_report`):

    rows              -- list[RowView]                       all renderable rows
    sections          -- list[SectionView]                   grouped rows + their kind/label/color/anchor
    toc_groups        -- list[{label, links}]                sidebar entries under two headings: "Integration"
                                                             (the escalation sections) and "Tests" (outcome sections)
    has_artifacts     -- bool                                whether to inject the asciinema head + JS + panels
    artifact_panels   -- list[PanelView]                     slide-in panels (one per agent that has artifacts)
    integrator        -- IntegratorResult | None             reduced-branch summary (drives merged-status cells)
    has_integrator    -- bool                                whether the integration report renders at all
    mapper_escalation_count    -- int                        how many escalations the mappers raised in total;
                                                             each one renders under its own row
    unresolved_escalation_views -- list[{summary, description_html, kind_label, scale_label, resolved_in_commit_hash}]
    resolved_escalation_views   -- same shape; resolved_in_commit_hash is always set
    rows[].escalations -- list[{id, description_html, kind_label, locations}]  rendered under their own row
    ungrouped_escalation_ids   -- list[str]                  mapper escalation ids no group claims
    unresolved_anchor / resolved_anchor -- str               ids the sidebar links to
    unresolved_color / resolved_color -- str                 heading colors matching the sidebar
    run_commands      -- list[(label, cmd)]                  top-of-report command hints (and reintegrate is used in FIX_FAILED hint)
    reintegrate_cmd   -- str                                 pre-extracted "Reintegrate" command (HTML-escaped)
    asciinema_css_url -- str                                 only meaningful when has_artifacts
    asciinema_js_url  -- str                                 only meaningful when has_artifacts
    detail_css        -- str                                 inlined verbatim under the report stylesheet
    css               -- str                                 inlined verbatim ahead of detail_css
    js                -- str                                 inlined verbatim near the bottom (artifacts.js)
-#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Test Map-Reduce Report</title>
{%- if has_artifacts %}
  <link rel="stylesheet" type="text/css" href="{{ asciinema_css_url }}">
  <script src="{{ asciinema_js_url }}"></script>
{%- endif %}
  <style>
{{ css|safe }}
{%- if has_artifacts %}
{{ detail_css|safe }}
{%- endif %}
  </style>
</head>
<body>
{%- if toc_groups %}
  <div class="toc-sidebar">
{%- for group in toc_groups %}
    <div class="toc-group-label">{{ group.label }}</div>
{%- for link in group.links %}
    <a href="#{{ link.anchor }}" class="toc-link" style="color: {{ link.color }};">{{ link.label }} ({{ link.count }})</a>
{%- endfor %}
{%- endfor %}
  </div>
{%- endif %}
  <div class="main-content">
    <h1>Test Map-Reduce Report</h1>
    <p class="summary">{{ rows|length }} test(s)</p>
{%- if run_commands %}
    <div class="run-commands">
{%- for label, cmd in run_commands %}
      <div class="run-cmd"><span class="run-cmd-label">{{ label }}:</span> <code>{{ cmd }}</code></div>
{%- endfor %}
    </div>
{%- endif %}
{%- if has_integrator %}
    <h2 class="group-heading">Integration</h2>
    <div class="integration-report">
      <p>The integrator is the only step that sees every mapper's report at once, so its
      escalations are groupings of theirs: many agents describe one problem in their own words.
      A group with no members is one the integrator found by reading the whole integrated diff,
      which no single mapper could have seen.{% if mapper_escalation_count %} Each of the
      {{ mapper_escalation_count }} mapper escalation(s) is shown in full under the test that
      raised it, below.{% endif %}</p>
{%- if ungrouped_escalation_ids %}
      <p class="coverage-warning"><strong>{{ ungrouped_escalation_ids|length }} mapper escalation(s)
      belong to no group below</strong>, so the grouped view is not the whole run. Each is still
      shown under the test that raised it.</p>
{%- endif %}
    </div>
{%- if unresolved_escalation_views %}
    <h3 id="{{ unresolved_anchor }}" style="color: {{ unresolved_color }};">Unresolved escalations ({{ unresolved_escalation_views|length }})</h3>
    <p>Problems the integrator could not resolve within the run. Each needs a decision or a change
    from a person, so each carries its whole description.</p>
    <table class="escalation-table">
      <thead>
        <tr><th>Escalation</th><th>Kind</th><th>Reports</th></tr>
      </thead>
      <tbody>
{%- for esc in unresolved_escalation_views %}
        <tr>
          <td class="md esc-description-cell">{{ esc.description_html|safe }}</td>
          <td>{{ esc.kind_label }}</td>
          <td class="esc-scale-cell">{{ esc.scale_label }}</td>
        </tr>
{%- endfor %}
      </tbody>
    </table>
{%- endif %}
{%- if resolved_escalation_views %}
    <h3 id="{{ resolved_anchor }}" style="color: {{ resolved_color }};">Resolved escalations ({{ resolved_escalation_views|length }})</h3>
    <p>Fixed and verified within the run. Shown as one line each; the commit carries the detail.</p>
    <table class="escalation-table escalation-table-with-commit">
      <thead>
        <tr><th>Escalation</th><th>Kind</th><th>Reports</th><th>Commit</th></tr>
      </thead>
      <tbody>
{%- for esc in resolved_escalation_views %}
        <tr>
          <td>{{ esc.summary }}</td>
          <td>{{ esc.kind_label }}</td>
          <td class="esc-scale-cell">{{ esc.scale_label }}</td>
          <td><code>{{ esc.resolved_in_commit_hash[:10] }}</code></td>
        </tr>
{%- endfor %}
      </tbody>
    </table>
{%- endif %}
{%- endif %}
{%- if sections %}
    <h2 class="group-heading">Tests</h2>
{%- endif %}
{%- for section in sections %}
    <h3 id="{{ section.anchor }}" style="color: {{ section.color }};">{{ section.label }} ({{ section.rows|length }})</h3>
{%- if section.kind == "FIX_FAILED" %}
    <div class="unresolved-hint">
      <p>To resolve issues with an agent that could not land its fix:</p>
      <ol>
        <li><code>mngr connect $agent_name</code></li>
        <li>When done, tell it to "regenerate the outcome file"</li>
{%- if reintegrate_cmd %}
        <li>Run: <code>{{ reintegrate_cmd|safe }}</code></li>
{%- endif %}
      </ol>
    </div>
{%- endif %}
{%- if section.kind == "TEST_AND_DOC_FIXES" and integrator and integrator.squashed_commit_hash %}
    <p class="squashed-hash">Squashed commit: <code>{{ integrator.squashed_commit_hash[:10] }}</code></p>
{%- endif %}
    <table>
      <thead>
        <tr>
{%- if section.kind == "RUNNING" %}
          <th>Test</th><th>Agent</th>
{%- elif section.kind == "CLEAN_PASS" %}
          <th>Test</th><th>Agent</th><th>Branch</th>{% if has_artifacts %}<th>Artifacts</th>{% endif %}
{%- else %}
          <th>Test</th><th>Changes</th><th>Agent</th><th>Branch</th><th>Merged?</th>{% if has_artifacts %}<th>Artifacts</th>{% endif %}
{%- endif %}
        </tr>
      </thead>
      <tbody>
{%- for row in section.rows %}
        <tr>
{%- if section.kind == "RUNNING" %}
          <td>{{ row.test_id_html|safe }}</td>
          <td><code>{{ row.agent_name }}</code></td>
{%- elif section.kind == "CLEAN_PASS" %}
          <td>{{ row.test_id_html|safe }}</td>
          <td><code>{{ row.agent_name }}</code></td>
          <td><code>{{ row.branch_name or "-" }}</code></td>
{%- if has_artifacts %}
{%- if row.has_artifacts %}
          <td><button class="artifacts-btn" data-agent="{{ row.agent_name }}">View</button></td>
{%- else %}
          <td>-</td>
{%- endif %}
{%- endif %}
{%- else %}
          <td>{{ row.test_id_html|safe }}</td>
          <td>{{ row.changes_html|safe }}</td>
          <td><code>{{ row.agent_name }}</code></td>
          <td><code>{{ row.branch_name or "-" }}</code></td>
          <td>{{ row.merged_html|safe }}</td>
{%- if has_artifacts %}
{%- if row.has_artifacts %}
          <td><button class="artifacts-btn" data-agent="{{ row.agent_name }}">View</button></td>
{%- else %}
          <td>-</td>
{%- endif %}
{%- endif %}
{%- endif %}
        </tr>
{%- if row.summary_html and section.kind != "RUNNING" %}
        <tr class="summary-row"><td colspan="{{ section.col_count }}" class="md summary-cell">{{ row.summary_html|safe }}</td></tr>
{%- endif %}
{%- if row.escalations and section.kind != "RUNNING" %}
        <tr class="escalation-row">
          <td colspan="{{ section.col_count }}">
            <span class="row-escalations-label">Escalations ({{ row.escalations|length }})</span>
            <table class="row-escalations escalation-table">
              <thead>
                <tr><th>Escalation</th><th>Kind</th><th>Location</th></tr>
              </thead>
              <tbody>
{%- for esc in row.escalations %}
                <tr>
                  <td class="esc-description-cell">
                    <div class="md">{{ esc.description_html|safe }}</div>
                    <code class="esc-id">{{ esc.id }}</code>
                  </td>
                  <td>{{ esc.kind_label }}</td>
                  <td>
{%- for location in esc.locations %}
                    <code class="esc-location">{{ location }}</code>
{%- endfor %}
{%- if not esc.locations %}-{% endif %}
                  </td>
                </tr>
{%- endfor %}
              </tbody>
            </table>
          </td>
        </tr>
{%- endif %}
{%- endfor %}
      </tbody>
    </table>
{%- endfor %}
  </div>
{%- if has_artifacts %}
  <div id="artifacts-overlay" class="artifacts-overlay"></div>
{%- for panel in artifact_panels %}
  <div class="artifacts-panel" id="panel-{{ panel.agent_name }}">
    <button class="artifacts-close">&times;</button>
    <h2>{{ panel.agent_name }}</h2>
{%- if panel.tab_count > 1 %}
    <div class="run-tabs">
{%- for i in range(panel.tab_count) %}
      <button class="run-tab{% if i == 0 %} active{% endif %}" data-agent="{{ panel.agent_name }}" data-run="{{ i }}">{{ i + 1 }}</button>
{%- endfor %}
    </div>
{%- endif %}
{%- for run in panel.runs %}
    <div class="run-content" data-agent="{{ panel.agent_name }}" data-run="{{ run.index }}"{% if run.index > 0 %} style="display:none"{% endif %}>
{%- if run.description_html %}
      <p><em>{{ run.description_html|safe }}</em></p>
{%- endif %}
      {{ run.detail_html|safe }}
    </div>
{%- endfor %}
  </div>
{%- endfor %}
  <script>
{{ js|safe }}
  </script>
{%- endif %}
</body>
</html>
