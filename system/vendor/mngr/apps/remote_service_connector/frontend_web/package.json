{
  "name": "connector-web-chrome",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write 'src/**/*.{ts,css}' '*.ts' 'index.html'",
    "format:check": "prettier --check 'src/**/*.{ts,css}' '*.ts' 'index.html'"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "hash-wasm": "^4.12.0",
    "mithril": "^2.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/mithril": "^2.2.7",
    "@types/node": "^25.4.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
