{#def pending=[], selected_id="", detail_html="", is_empty=False, pending_json="[]" #}
{#
  The permission-request popup: one centered dialog over the workspace,
  the only surface a pending request is reviewed on (the old inbox drawer
  and its titlebar Requests button are gone). Hosts:
    - Transparent body + dim backdrop (so the desktop client modal view
      reveals the workspace behind the popup).
    - An eyebrow header naming the asking workspace ("Permission request
      for [dot] <workspace>") over the request's detail fragment.
    - The shell JS that owns Approve/Deny submission, the advance-to-next
      queue, and escape/backdrop dismissal.

  ``pending`` is the ordered pending-request metadata (dicts with ``id``,
  ``ws_name``, ``accent``), newest first; ``pending_json`` is the same
  data pre-serialized for the shell script. ``selected_id`` is the id
  of the request being shown; ``detail_html`` its pre-rendered handler
  fragment (or the "no longer available" fragment). ``is_empty`` is True
  when there are no pending requests at all, which renders the caught-up
  state.

  Resolving the shown request advances to the next pending one, and the
  popup dismisses itself when none remain. It is opened by the Electron
  auto-open path (a genuinely new request arrived) or by the chat card's
  "Review & respond" relay, always over the current view.
#}
{% set _head %}
  <style>
    /* Pop-in: the card slides down slightly and fades; the backdrop
       scrim fades alongside on the same timing. Runs once per open
       (the modal view loads a fresh page each time). */
    @keyframes request-popup-in {
      from { transform: translateY(-8px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }
    #request-popup { animation: request-popup-in 180ms cubic-bezier(0, 0.55, 0.45, 1); }
    @keyframes request-backdrop-fade-in {
      from { background-color: rgba(0, 0, 0, 0); }
      to   { background-color: rgba(0, 0, 0, 0.2); }
    }
    #inbox-backdrop { animation: request-backdrop-fade-in 180ms cubic-bezier(0, 0.55, 0.45, 1); }
  </style>
{% endset %}
{% set _scripts %}
<script>
  (function () {
    var inboxDetail = document.getElementById("inbox-detail");

    // The pending queue, newest first, as [{id, ws_name, accent}]. The
    // popup shows one request at a time and advances through this queue
    // as requests resolve; SSE events reconcile it live.
    var pendingQueue = [];
    try {
      pendingQueue = JSON.parse(document.getElementById("inbox-pending-data").textContent) || [];
    } catch (e) { pendingQueue = []; }
    var currentId = {{ selected_id | tojson }};
    // Ids whose deny POST is in flight: excluded from advance targets so
    // the user is never bounced into a dialog that is about to vanish.
    var denyingIds = new Set();
    // While an approval is running (possibly a browser sign-in), SSE
    // reconciliation must not swap the pane out from under it.
    var approveBusy = false;

    // Where the browser-mode popup returns on close: an optional local-path
    // ``return_to`` query param (the Permissions page passes its own URL so
    // reviewing a request hands back there), validated to a single-slash
    // local path; anything else falls back to home. Electron ignores this --
    // its close routes through the modal-dismissal IPCs, which restore any
    // modal the popup displaced (the workspace-options panel).
    function browserReturnTarget() {
      try {
        var raw = new URLSearchParams(window.location.search).get("return_to") || "";
        if (/^\/(?!\/)[A-Za-z0-9\-._~/?=&%]*$/.test(raw)) return raw;
      } catch (e) { /* fall through to home */ }
      return "/";
    }

    // ``didResolve`` distinguishes the two close paths: a close after the
    // user resolved a request completes the detour (the revealed modal
    // re-renders, so a Permissions panel's waiting strip drops the resolved
    // row); a plain dismissal (Escape, backdrop, the X) restores it as-is.
    function closeInbox(didResolve) {
      if (window.minds && window.minds.closeModal) {
        if (didResolve && window.minds.completeModalDetour) {
          window.minds.completeModalDetour();
        } else {
          window.minds.closeModal();
        }
      } else {
        window.location.href = browserReturnTarget();
      }
    }
    window.closeInbox = closeInbox;

    function onBackdropClick(event) {
      if (event.target && event.target.id === "inbox-backdrop") closeInbox();
    }
    window.onBackdropClick = onBackdropClick;

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeInbox();
    });

    // The Adjust toggle (predefined-permission "simple vs editor" view)
    // lives here as a global so the fragment's onclick=showPermissionEditor()
    // still works after a pane swap (fragments carry no scripts).
    window.showPermissionEditor = function () {
      var simple = document.getElementById("permissions-simple-view");
      var editor = document.getElementById("permissions-editor-view");
      if (simple) simple.classList.add("hidden");
      if (editor) editor.classList.remove("hidden");
    };

    // Parse the WebDAV mount roots the file-sharing dialog embeds on its
    // path input (a JSON array of absolute paths). Returns [] when absent
    // or malformed.
    function sharePathRoots(input) {
      try {
        var parsed = JSON.parse(input.getAttribute("data-allowed-roots") || "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    // Expand a leading ``~`` / ``~/`` to the home directory the
    // file-sharing dialog embeds on its path input, mirroring the
    // server-side ``_expand_home_prefix``. A bare ``~`` or ``~/...``
    // expands; ``~user`` (another user's home) is left unchanged so the
    // within-roots check rejects it, matching the server.
    function expandSharePathHome(value, input) {
      var home = String(input.getAttribute("data-home-dir") || "");
      if (!home) return value;
      if (value === "~" || value.indexOf("~/") === 0) {
        return home + value.slice(1);
      }
      return value;
    }

    // Whether ``value`` is at or beneath one of ``roots``. Case-insensitive
    // and purely lexical, mirroring the server-side check (and WsgiDAV's
    // share-prefix matching).
    function isSharePathWithinRoots(value, roots) {
      if (!value) return false;
      var lower = value.toLowerCase();
      return roots.some(function (root) {
        var r = String(root).replace(/\/+$/, "").toLowerCase() || "/";
        return lower === r || lower.indexOf(r + "/") === 0;
      });
    }

    // The predefined-permission dialog offers a catch-all permission
    // (stored as ``any``, shown to users as ``all``) alongside the
    // specific permissions. While it is ticked, the specific checkboxes
    // are disabled (the browser omits disabled inputs from the
    // submission, so only the active side is granted).
    function syncPermissionWildcardExclusivity() {
      var form = document.getElementById("permissions-form");
      if (!form) return;
      var wildcard = form.querySelector('input[name="permissions"][data-wildcard]');
      if (!wildcard) return;
      form.querySelectorAll('input[name="permissions"]').forEach(function (box) {
        if (box !== wildcard) box.disabled = wildcard.checked;
      });
    }

    function updateApproveState() {
      var form = document.getElementById("permissions-form");
      if (!form) return;
      var approveBtn = document.getElementById("permissions-approve-btn");
      if (!approveBtn) return;
      syncPermissionWildcardExclusivity();
      var anyChecked = form.querySelector('input[name="permissions"]:checked') !== null;
      // The file-sharing dialog adds an editable path field. Its hidden
      // "permissions" checkbox is always checked, so gate Approve on the
      // path being both non-empty AND inside a shared root, with an
      // instant hint for out-of-root paths (matching the server-side
      // rejection).
      var pathInput = document.getElementById("file-sharing-path-input");
      var pathOk = true;
      if (pathInput) {
        var value = expandSharePathHome(pathInput.value.trim(), pathInput);
        var withinRoots = isSharePathWithinRoots(value, sharePathRoots(pathInput));
        pathOk = value.length > 0 && withinRoots;
        var hint = document.getElementById("file-sharing-path-hint");
        if (hint) hint.classList.toggle("hidden", !(value.length > 0 && !withinRoots));
      }
      approveBtn.disabled = !(anyChecked && pathOk);
    }
    window.updateApproveState = updateApproveState;

    // The file-sharing dialog ships its "Choose file…" / "Choose folder…"
    // buttons hidden; reveal them only when the Electron native-picker
    // bridge is available. Idempotent: safe to call after every pane swap.
    function wireSharePathControls() {
      if (!(window.minds && window.minds.showFilePicker)) return;
      ["file-sharing-browse-file-btn", "file-sharing-browse-folder-btn"].forEach(function (id) {
        var btn = document.getElementById(id);
        if (btn) btn.classList.remove("hidden");
      });
    }

    // Open the OS picker for the requested ``mode`` ('file' or
    // 'directory') and write the chosen absolute path back into the
    // share-path input. A cancel (or bridge error) leaves the field alone.
    window.browseForSharePath = async function (mode) {
      var input = document.getElementById("file-sharing-path-input");
      if (!input || !(window.minds && window.minds.showFilePicker)) return;
      try {
        var selected = await window.minds.showFilePicker({
          defaultPath: input.value.trim(),
          mode: mode === "directory" ? "directory" : "file",
        });
        if (typeof selected === "string" && selected.length > 0) {
          input.value = selected;
          updateApproveState();
        }
      } catch (e) {
        /* user cancelled or the bridge errored -- keep the current path */
      }
    };

    // -- Queue navigation -----------------------------------------------

    function metaFor(id) {
      for (var i = 0; i < pendingQueue.length; i += 1) {
        if (pendingQueue[i].id === id) return pendingQueue[i];
      }
      return null;
    }

    // Repaint the eyebrow ("Permission request for [dot] <workspace>")
    // for the request on screen; a missing meta (stale id) keeps the
    // generic title with the dot hidden.
    function updateEyebrow(id) {
      var meta = id ? metaFor(id) : null;
      var nameEl = document.getElementById("request-popup-ws-name");
      var dotEl = document.getElementById("request-popup-ws-dot");
      var forEl = document.getElementById("request-popup-for");
      if (nameEl) nameEl.textContent = meta ? meta.ws_name : "";
      if (dotEl) {
        dotEl.classList.toggle("hidden", !meta);
        if (meta) dotEl.style.backgroundColor = meta.accent;
      }
      if (forEl) forEl.classList.toggle("hidden", !meta);
    }

    function nextPendingId(excludedId) {
      for (var i = 0; i < pendingQueue.length; i += 1) {
        var id = pendingQueue[i].id;
        if (id !== excludedId && !denyingIds.has(id)) return id;
      }
      return null;
    }

    async function fetchDetailFragment(id) {
      var resp = await fetch("/inbox/detail/" + encodeURIComponent(id), { credentials: "same-origin" });
      if (!resp.ok) {
        // The server returns 200 with an "unavailable" fragment for stale
        // ids; anything else is a real error, leave the pane untouched.
        return;
      }
      var html = await resp.text();
      inboxDetail.innerHTML = html;
      updateApproveState();
      wireSharePathControls();
    }

    function updateUrl(id) {
      try {
        history.replaceState(null, "", id ? "/inbox?selected=" + encodeURIComponent(id) : "/inbox");
      } catch (e) { /* noop in restricted contexts */ }
    }

    async function showRequest(id) {
      currentId = id;
      updateEyebrow(id);
      updateUrl(id);
      if (id) await fetchDetailFragment(id);
    }

    // After the shown request resolves: advance to the next pending one,
    // or dismiss the popup when nothing is left (completing the detour, so
    // a displaced Permissions panel comes back re-rendered). Any in-flight
    // deny POST carries keepalive:true, so it completes after the window
    // closes.
    async function advanceAfterResolution(resolvedId) {
      pendingQueue = pendingQueue.filter(function (m) { return m.id !== resolvedId; });
      var nextId = nextPendingId(resolvedId);
      if (nextId) {
        await showRequest(nextId);
      } else {
        closeInbox(true);
      }
    }

    // -- Approve / Deny submission --------------------------------------

    // Bring a just-revealed notice (progress / error / manual credentials)
    // into view at the bottom of the scrollable pane.
    function scrollDetailIntoView(el) {
      if (!el) return;
      try {
        inboxDetail.scrollTo({ top: inboxDetail.scrollHeight, behavior: "smooth" });
      } catch (e) {
        inboxDetail.scrollTop = inboxDetail.scrollHeight;
      }
    }

    // Toggle the "an approval is running in the background" state. While
    // busy, BOTH buttons are disabled and the Approve label is swapped for
    // a spinner + "Approving...", so the user always has a clear signal
    // that work is underway (a browser sign-in, a follow-up grant) and
    // cannot double-submit or deny mid-flight.
    function setApproveBusy(isBusy) {
      approveBusy = isBusy;
      var approveBtn = document.getElementById("permissions-approve-btn");
      var denyBtn = document.getElementById("permissions-deny-btn");
      var spinner = document.getElementById("permissions-approve-spinner");
      var label = document.getElementById("permissions-approve-label");
      if (isBusy) {
        if (approveBtn) approveBtn.disabled = true;
        if (denyBtn) denyBtn.disabled = true;
        if (spinner) spinner.classList.remove("hidden");
        if (label) label.textContent = "Approving…";
      } else {
        if (denyBtn) denyBtn.disabled = false;
        if (spinner) spinner.classList.add("hidden");
        if (label) label.textContent = label && label.dataset.idleLabel ? label.dataset.idleLabel : "Approve";
        updateApproveState();
      }
    }

    async function submitGrant(form, resolvedId) {
      var errorBox = document.getElementById("permissions-error");
      var errorMsg = document.getElementById("permissions-error-message");
      var manualBox = document.getElementById("permissions-manual-credentials");
      var progress = document.getElementById("permissions-progress");
      setApproveBusy(true);
      if (errorBox) errorBox.classList.add("hidden");
      if (manualBox) manualBox.classList.add("hidden");
      if (progress) {
        progress.classList.remove("hidden");
        scrollDetailIntoView(progress);
      }

      var formData = new FormData(form);
      try {
        var response = await fetch(form.action, {
          method: "POST",
          body: formData,
          credentials: "same-origin",
        });
        if (!response.ok) {
          var text = await response.text();
          throw new Error(text || ("HTTP " + response.status));
        }
        var data = await response.json();
        if (data.outcome === "GRANTED" || data.outcome === "DENIED") {
          setApproveBusy(false);
          await advanceAfterResolution(resolvedId);
          return;
        }
        if (progress) progress.classList.add("hidden");
        if (data.outcome === "NEEDS_MANUAL_CREDENTIALS") {
          var cmdEl = document.getElementById("permissions-manual-credentials-command");
          var msgEl = document.getElementById("permissions-manual-credentials-message");
          if (cmdEl) cmdEl.textContent = data.set_credentials_example || "";
          if (msgEl) msgEl.textContent = data.message || "";
          if (manualBox) {
            manualBox.classList.remove("hidden");
            scrollDetailIntoView(manualBox);
          }
          setApproveBusy(false);
          return;
        }
        // FAILED: the approval did not complete (e.g. the browser sign-in
        // flow failed). The request stays pending server-side; show the
        // reason and re-enable Approve so the user can retry -- this is a
        // failure, not a denial.
        if (data.outcome === "FAILED") {
          if (errorMsg) errorMsg.textContent = data.message || "Approval failed; please try again.";
          if (errorBox) {
            errorBox.classList.remove("hidden");
            scrollDetailIntoView(errorBox);
          }
          setApproveBusy(false);
          return;
        }
        if (errorMsg) errorMsg.textContent = data.message || "Authorization failed.";
        if (errorBox) {
          errorBox.classList.remove("hidden");
          scrollDetailIntoView(errorBox);
        }
        setApproveBusy(false);
      } catch (err) {
        if (progress) progress.classList.add("hidden");
        if (errorMsg) errorMsg.textContent = err && err.message ? err.message : String(err);
        if (errorBox) {
          errorBox.classList.remove("hidden");
          scrollDetailIntoView(errorBox);
        }
        setApproveBusy(false);
      }
    }

    window.submitPermissionDeny = function () {
      var form = document.getElementById("permissions-form");
      if (!form) return;
      var resolvedId = currentId;
      if (resolvedId) denyingIds.add(resolvedId);
      // Disable both buttons so the resolving request can't be re-actioned
      // while the deny POST is in flight and the popup advances.
      var approveBtn = document.getElementById("permissions-approve-btn");
      if (approveBtn) approveBtn.disabled = true;
      var denyBtn = document.getElementById("permissions-deny-btn");
      if (denyBtn) denyBtn.disabled = true;
      var denyUrl = form.action.replace(/\/grant\b/, "/deny");
      // Fire-and-forget so the user doesn't wait for mngr message round
      // trips; keepalive lets the request finish even if the popup closes.
      fetch(denyUrl, {
        method: "POST",
        credentials: "same-origin",
        keepalive: true,
      }).catch(function () {});
      advanceAfterResolution(resolvedId);
    };

    // -- Event delegation ------------------------------------------------

    inboxDetail.addEventListener("submit", function (e) {
      var form = e.target;
      if (!form || form.id !== "permissions-form") return;
      e.preventDefault();
      submitGrant(form, currentId);
    });

    inboxDetail.addEventListener("change", function (e) {
      if (e.target && e.target.name === "permissions") updateApproveState();
    });

    // -- SSE-driven queue reconciliation (Electron forwards chrome events) --

    if (window.minds && window.minds.onChromeEvent) {
      window.minds.onChromeEvent(function (evt) {
        if (!evt || evt.type !== "requests") return;
        var newIds = Array.isArray(evt.request_ids) ? evt.request_ids.map(String) : [];
        // Keep known metadata; a genuinely new id has no meta yet, so the
        // eyebrow falls back to the generic title if it is ever shown
        // before a reload provides the workspace name.
        var known = {};
        pendingQueue.forEach(function (m) { known[m.id] = m; });
        pendingQueue = newIds.map(function (id) { return known[id] || { id: id, ws_name: "", accent: "" }; });
        if (approveBusy) return;
        if (currentId && newIds.indexOf(currentId) === -1) {
          // The shown request resolved on another surface; advance to the
          // next pending one or dismiss.
          advanceAfterResolution(currentId);
        }
      });
    }

    // Initial state: Approve-button availability for the server-rendered
    // detail, native-picker wiring, and the eyebrow for the selection.
    updateApproveState();
    wireSharePathControls();
    updateEyebrow(currentId);
  })();
</script>
{% endset %}
<OverlaySurface title="Permission request"
                body_style="-webkit-app-region: no-drag;"
                head={{ _head }}
                scripts={{ _scripts }}>
  <script type="application/json" id="inbox-pending-data">{{ pending_json | safe }}</script>
  {# Centered popup over a dim backdrop. A 38px strip across the top of
     the backdrop keeps a window-drag handle available while the modal
     covers the chrome titlebar (the OS swallows mousedown for dragging
     there, so click-to-dismiss still works on the rest of the scrim). #}
  <div id="inbox-backdrop"
       class="fixed inset-0 bg-surface-overlay flex items-center justify-center p-4"
       onclick="onBackdropClick(event)">
    <div class="absolute top-0 left-0 right-0 h-[38px]"
         style="-webkit-app-region: drag;"></div>
    <div id="request-popup"
         class="relative w-[min(600px,92vw)] max-h-[85vh] flex flex-col rounded-xl bg-surface-primary shadow-overlay overflow-hidden">
      {# Eyebrow header on one line: "Permission request for [dot] <workspace>",
         with the close button on the right. The dot carries the asking
         workspace's accent; the shell JS repaints both as the popup
         advances through the pending queue. #}
      <div class="flex items-center justify-between gap-3 px-4 pt-3 pb-1 shrink-0">
        <span class="flex min-w-0 items-center gap-1.5 type-label font-semibold text-primary">
          <Icon16 name="key" size="sm" extra="shrink-0" />
          <span class="shrink-0">Permission request</span>
          {% set _selected_meta = (pending | selectattr("id", "equalto", selected_id) | list | first) if selected_id else none %}
          <span id="request-popup-for" class="shrink-0{% if not _selected_meta %} hidden{% endif %}">for</span>
          <span id="request-popup-ws-dot" aria-hidden="true"
                class="h-2.5 w-2.5 shrink-0 rounded-full{% if not _selected_meta %} hidden{% endif %}"
                {% if _selected_meta %}style="background-color: {{ _selected_meta.accent }}"{% endif %}></span>
          <span id="request-popup-ws-name" class="truncate">{{ _selected_meta.ws_name if _selected_meta else "" }}</span>
        </span>
        <button type="button" aria-label="Close" data-tooltip="Close"
                id="inbox-close-btn"
                onclick="closeInbox()"
                class="shrink-0 inline-flex items-center justify-center w-6 h-6 rounded-md text-tertiary hover:text-primary hover:bg-fill-hover cursor-pointer">
          <Icon16 name="close" />
        </button>
      </div>
      <div id="inbox-detail" class="flex-1 min-h-0 overflow-y-auto px-6 pb-6 pt-2">
        {% if is_empty %}
          <p class="type-body text-secondary text-center py-8">You're all caught up — no pending requests.</p>
        {% else %}
          {{ detail_html|safe }}
        {% endif %}
      </div>
    </div>
  </div>
</OverlaySurface>
