{#def agent_id, request_id, ws_name, rationale, display_name, service_name, summary_rows, permission_groups, account_choices, selected_account_value, will_open_browser, approve_label, mngr_forward_origin #}
{#
  Latchkey predefined permission request fragment. Rendered inside the
  inbox modal's dialog body (the shell's eyebrow names the requesting
  workspace). Provides the title row + reason (via PermissionsHeader),
  the account picker, the per-permission simple/editor views and the
  auth-browser progress state. Chrome (close button, escape dismiss,
  form submission JS, Adjust toggle) lives in the inbox shell and
  operates on these elements via the ids below (#permissions-form,
  #permissions-simple-view, etc.).

  ``summary_rows`` are the checked permissions (human label +
  description) shown in the read-only simple view; ``permission_groups``
  are every offered permission grouped under section eyebrows for the
  hidden editor view. Both are prepared in handlers/templates.py so the
  template stays free of grouping logic.

  Grants are per account: the form always submits exactly one ``account``
  radio, either an account already signed in to the service or the
  "new account" choice, which makes Approve run a browser sign-in first.
#}
<div class="permissions-detail">
  <PermissionsForm :request_id="request_id" :approve_label="approve_label">
    <PermissionsHeader :display_name="display_name" :service_name="service_name" :rationale="rationale">
      {# Account picker: which signed-in account of the service the grant
         applies to. Rendered above the reason because the account is what
         the permissions are scoped to. A single radio is always
         preselected, so the form can never submit without an account. #}
      {% if account_choices %}
        <div id="permissions-account-view" class="mt-4">
          <h3 class="type-section text-tertiary">Account</h3>
          <div class="mt-1 space-y-1">
            {% for choice in account_choices %}
              <label class="flex items-start gap-2 cursor-pointer">
                <input type="radio" name="account" value="{{ choice.value }}" class="mt-1 shrink-0"
                       {% if choice.value == selected_account_value %}checked{% endif %}>
                <span class="min-w-0">
                  <span class="type-body text-primary">{{ choice.label }}</span>
                  {% if choice.hint %}
                    <span class="type-helper text-tertiary"> &middot; {{ choice.hint }}</span>
                  {% endif %}
                </span>
              </label>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </PermissionsHeader>

    {# Simple (default) view: a read-only summary of the permissions that
       will be granted on Approve, with no checkboxes. The full checkbox
       editor is hidden behind the "Adjust" link below. #}
    <div id="permissions-simple-view" class="mt-4">
      {% if summary_rows %}
        <h3 class="type-section text-tertiary">Approving will let the agent</h3>
        <ul class="mt-1 space-y-2">
          {% for row in summary_rows %}
            <li class="flex items-start gap-2">
              <Icon16 name="check" extra="shrink-0 text-success mt-0.5" />
              <span class="min-w-0">
                <span class="block font-semibold">{{ row.label }}</span>
                {% if row.description %}
                  <span class="block type-helper text-secondary">{{ row.description }}</span>
                {% endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
        <div class="flex justify-end mt-2">
          <Button variant="ghost" id="permissions-adjust-link"
                  onclick="showPermissionEditor()"
                  extra="!p-0 !bg-transparent !type-helper !text-accent hover:!bg-transparent hover:underline">
            Adjust
          </Button>
        </div>
      {% else %}
        <Notice variant="warn">
          The agent did not request any specific permissions. Click
          <span class="font-semibold">Adjust</span> below to choose what to grant.
        </Notice>
        <div class="flex justify-end mt-3">
          <Button variant="ghost" id="permissions-adjust-link"
                  onclick="showPermissionEditor()"
                  extra="!p-0 !bg-transparent !type-helper !text-accent hover:!bg-transparent hover:underline">
            Adjust
          </Button>
        </div>
      {% endif %}
    </div>

    {# Editor view: the full grant list grouped under section eyebrows,
       hidden until the user opts in via "Adjust". Each row is a real
       ``name="permissions"`` checkbox rendered as a toggle switch
       (``perm-switch-input`` in app.css styles the input itself, so the
       submitted form data is unchanged), label block on the left and the
       switch on the right, matching the Permissions screen's toggles.
       The inputs are present in the DOM either way so the generic submit
       handler can read the checked set. The wildcard (Extras) group sits
       behind a divider and its label carries the warning tone so the
       catch-all stands out. #}
    <div id="permissions-editor-view" class="hidden mt-4">
      {% for group in permission_groups %}
        {% if group.is_extras %}
          <div class="mt-4 pt-3 border-t border-subtle"></div>
        {% endif %}
        <h4 class="type-section text-tertiary {{ 'mt-4' if not loop.first and not group.is_extras else '' }}">{{ group.heading }}</h4>
        <div class="mt-1 flex flex-col">
          {% for row in group.rows %}
            <label class="flex items-start justify-between gap-4 py-1.5 cursor-pointer">
              <span class="min-w-0">
                <span class="type-body font-semibold {{ 'text-warning' if row.is_wildcard else 'text-primary' }}">{{ row.label }}</span>
                <code class="code-pill">{{ row.shown_name }}</code>
                {% if row.description %}
                  <span class="block type-helper text-secondary mt-0.5">{{ row.description }}</span>
                {% endif %}
              </span>
              <input type="checkbox" name="permissions" value="{{ row.permission }}"
                     class="perm-switch-input shrink-0 mt-0.5"
                     {% if row.is_wildcard %}data-wildcard="true"{% endif %}
                     {% if row.is_checked %}checked{% endif %}>
            </label>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </PermissionsForm>

  {#
    The progress state's copy depends on whether ``latchkey auth browser``
    will actually run when the user clicks Approve. ``will_open_browser``
    is computed server-side from a fresh ``latchkey services info`` call,
    so when credentials are already valid (or the service requires manual
    credentials) we show a generic "Granting permission…" state instead
    of falsely promising a browser pop-up.
  #}
  <div id="permissions-progress" class="hidden mt-4">
    <div class="flex flex-col items-center gap-3 py-6 text-center">
      <Spinner />
      {% if will_open_browser %}
        <p class="type-body text-primary">Finish signing in to <span class="font-semibold">{{ display_name }}</span> in your browser…</p>
        <p class="type-helper text-tertiary">You sign in once for this Mac — every machine can then ask to use it.</p>
      {% else %}
        <p class="type-body text-primary">Granting permission…</p>
      {% endif %}
    </div>
  </div>

  <PermissionsManualCredentials />
  <PermissionsError />
</div>
