{#def display_name, rationale, service_name="", icon_name="box" #}
{#
  Permissions dialog header: a 32px service-mark tile next to the display
  name, an optional content slot (the predefined dialog places its account
  picker there, between the title and the reason), and the "Reason"
  section carrying the agent's rationale. The requesting workspace is
  named by the inbox shell's eyebrow, so the header no longer repeats it.

  ``service_name`` is the raw catalog service name; when it ships a brand
  mark (see the ``SERVICE_ICON_NAMES`` catalog global) the tile shows it,
  otherwise the tile falls back to the ``icon_name`` glyph from Icon16.
#}
<div class="flex items-center gap-3">
  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-fill-subtle">
    {% if service_name and service_name in SERVICE_ICON_NAMES %}
      <img src="/_static/service_icons/{{ service_name }}.svg" alt="" class="w-4 h-4" />
    {% else %}
      <Icon16 :name="icon_name" />
    {% endif %}
  </div>
  <h2 class="type-heading text-primary">{{ display_name }}</h2>
</div>

{{ content }}

<div class="mt-4">
  <h3 class="type-section text-tertiary">Reason</h3>
  <p class="mt-1 type-body text-primary whitespace-pre-wrap">{{ rationale }}</p>
</div>
