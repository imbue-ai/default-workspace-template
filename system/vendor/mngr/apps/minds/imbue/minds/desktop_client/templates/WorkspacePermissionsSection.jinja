{#def agent_id, ws_name, permissions_view=None, waiting_requests=[], panel_scroll=False #}
{#
  The "Permissions" pane: everything agents in this machine can access,
  rendered as toggles. Shared verbatim between the docked options panel
  (pages.WorkspaceOptionsModal) and the full options page
  (pages.WorkspaceOptions), like its sibling Share / Settings panes.

  Left nav: one entry per connection (a signed-in or granted (service,
  account) pair), an Add connection entry for the rest of the catalog, then
  the two latchkey-self families -- Local files (shared paths) and Other
  machines (cross-workspace verbs). Right pane: the selected entry's toggles.

  Flipping a toggle POSTs the single flip to the workspace's permission
  routes; the SERVER recomputes the affected rule's complete permission set
  (never a diff -- see latchkey/permission_toggles.py) and writes it through
  the gateway. Interactivity lives in /_static/workspace_permissions.js,
  bound by the data-perm-* attributes below.

  ``permissions_view`` is a WorkspacePermissionsView, or None when the
  latchkey gateway (or the workspace's host) is unavailable -- the pane then
  renders a warn notice instead of stale toggles.

  ``panel_scroll`` mirrors the sibling panes: the docked panel pins the
  heading + nav and scrolls only the right pane.
#}
<h1 class="type-heading text-primary flex items-center gap-2 min-w-0 shrink-0">
  <Icon16 name="key" size="lg" extra="shrink-0" />
  <span class="shrink-0">Permissions:</span>
  <span class="truncate max-w-[280px]">{{ ws_name }}</span>
</h1>
<p class="mt-2 max-w-[760px] type-body text-primary shrink-0">
  What agents in <span class="font-semibold">{{ ws_name }}</span> can access. They can never reach
  beyond the permissions you grant them.
</p>

{# -- Waiting on you: pending permission requests from this machine's agents,
   oldest first (the one the agent has been blocked on longest leads). Plain
   rows -- no borders or backgrounds -- each opening the shared review popup.
   Only the first three show; the rest fold under a grey "+N more" the page
   script (workspace_permissions.js) reveals. Hidden entirely when nothing
   is pending. #}
{% if waiting_requests %}
<section class="mt-6 shrink-0 max-w-[760px]" id="ws-perm-waiting">
  <h2 class="type-section text-tertiary flex items-center gap-1.5">
    Waiting on you
    <Badge count={{ waiting_requests | length }} />
  </h2>
  <div class="mt-2 flex flex-col gap-0.5">
    {% for waiting in waiting_requests %}
    <button type="button"
            class="perm-waiting-row flex w-full items-center gap-2 rounded-md px-1 py-2 text-left cursor-pointer hover:bg-fill-hover{{ ' hidden' if loop.index0 >= 3 else '' }}"
            data-request-id="{{ waiting.id }}">
      <span class="flex h-5 w-5 shrink-0 items-center justify-center">
        {% if waiting.service_name and waiting.service_name in SERVICE_ICON_NAMES %}
          <img src="/_static/service_icons/{{ waiting.service_name }}.svg" alt="" class="w-4 h-4" />
        {% else %}
          <Icon16 name="key" extra="text-primary" />
        {% endif %}
      </span>
      <span class="min-w-0 flex-1">
        <span class="block truncate type-label text-primary">{{ waiting.title }}</span>
        {% if waiting.reason %}
          <span class="mt-0.5 block truncate type-helper text-secondary">{{ waiting.reason }}</span>
        {% endif %}
      </span>
      <Icon16 name="chevron-right" size="sm" extra="shrink-0 text-tertiary" />
    </button>
    {% endfor %}
  </div>
  {% if waiting_requests | length > 3 %}
    <button type="button" id="ws-perm-waiting-more"
            class="mt-1.5 ml-1 type-helper text-tertiary hover:text-secondary cursor-pointer">
      +{{ waiting_requests | length - 3 }} more
    </button>
  {% endif %}
</section>
{% endif %}

{% if permissions_view is none %}
  <div class="mt-6 shrink-0">
    <Notice variant="warn">
      Permissions can't be loaded right now. Try again in a moment.
    </Notice>
  </div>
{% else %}
{% set _selected = "conn-0" if permissions_view.connections else "add-connection" %}
<div id="ws-permissions" data-agent-id="{{ agent_id }}" class="mt-8 flex gap-8 flex-1 min-h-0">
  <nav class="shrink-0 w-52 {{ 'overflow-y-auto min-h-0 p-1.5 -m-1.5' if panel_scroll else '' }}" aria-label="Permission sections">
    <div class="flex flex-col gap-0.5">
      {% for connection in permissions_view.connections %}
      {% set _key = "conn-" ~ loop.index0 %}
      <button type="button"
              data-perm-nav="{{ _key }}"
              aria-pressed="{{ 'true' if _key == _selected else 'false' }}"
              class="flex w-full items-center gap-2 rounded-md px-2 py-1 text-left type-body cursor-pointer transition-colors text-primary hover:bg-fill-hover{{ ' bg-fill-hover font-semibold' if _key == _selected else '' }}">
        {% if connection.service_name in SERVICE_ICON_NAMES %}
          <img src="/_static/service_icons/{{ connection.service_name }}.svg" alt="" class="w-4 h-4 shrink-0" />
        {% else %}
          <Icon16 name="box" extra="shrink-0" />
        {% endif %}
        <span class="truncate min-w-0">
          {{ connection.display_name }}{% if connection.show_account_label %}
          <span class="block type-helper text-tertiary truncate font-normal">{{ connection.account_label }}</span>
          {% endif %}
        </span>
      </button>
      {% endfor %}
      <button type="button"
              data-perm-nav="add-connection"
              aria-pressed="{{ 'true' if _selected == 'add-connection' else 'false' }}"
              class="flex w-full items-center gap-2 rounded-md px-2 py-1 text-left type-body cursor-pointer transition-colors text-secondary hover:text-primary hover:bg-fill-hover{{ ' bg-fill-hover font-semibold text-primary' if _selected == 'add-connection' else '' }}">
        <Icon16 name="plus" extra="shrink-0" />
        <span class="truncate">Add connection</span>
      </button>
    </div>
    <div class="my-1.5 h-px bg-subtle"></div>
    <div class="flex flex-col gap-0.5">
      <button type="button"
              data-perm-nav="local-files"
              aria-pressed="false"
              class="flex w-full items-center gap-2 rounded-md px-2 py-1 text-left type-body cursor-pointer transition-colors text-primary hover:bg-fill-hover">
        <Icon16 name="box" extra="shrink-0" />
        <span class="truncate">Local files</span>
      </button>
      <button type="button"
              data-perm-nav="other-machines"
              aria-pressed="false"
              class="flex w-full items-center gap-2 rounded-md px-2 py-1 text-left type-body cursor-pointer transition-colors text-primary hover:bg-fill-hover">
        <Icon16 name="panels-top-left" extra="shrink-0" />
        <span class="truncate">Other machines</span>
      </button>
    </div>
  </nav>

  <div class="flex-1 min-w-0 flex flex-col {{ 'overflow-y-auto min-h-0 pt-1.5 pb-1.5 pl-1.5 pr-6 -mt-1.5 -mb-1.5 -ml-1.5 -mr-6' if panel_scroll else '' }}">
    <p id="ws-perm-error" class="hidden type-body text-important mb-3 shrink-0" role="alert"></p>

    {% for connection in permissions_view.connections %}
    {% set _key = "conn-" ~ loop.index0 %}
    <section data-perm-panel="{{ _key }}" class="{{ '' if _key == _selected else 'hidden' }}">
      <div class="flex items-center justify-between gap-3 mb-1">
        <h2 class="type-heading-lg text-primary flex items-center gap-2 min-w-0">
          {% if connection.service_name in SERVICE_ICON_NAMES %}
            <img src="/_static/service_icons/{{ connection.service_name }}.svg" alt="" class="w-5 h-5 shrink-0" />
          {% endif %}
          <span class="truncate">{{ connection.display_name }}</span>
          <span class="type-body text-tertiary font-normal truncate">&middot; {{ connection.account_label }}</span>
        </h2>
        {% if connection.granted_count %}
          {# Dynamic data-* on a JinjaX component needs the ``attr={{ expr }}``
             binding form -- a quoted "{{ ... }}" would pass through verbatim. #}
          <Button variant="ghost" size="md" class="perm-revoke-all-btn shrink-0"
                  data-service-name={{ connection.service_name }}
                  data-service-label={{ connection.display_name }}
                  data-account={{ connection.account }}>Revoke all</Button>
        {% endif %}
      </div>
      <p class="type-body text-secondary mb-4">Choose what agents in this machine can do.</p>
      {% if not connection.is_connected %}
        <Notice variant="warn">
          This account isn't connected, so agents can't use these grants right now. Reconnect it
          from Minds settings &rarr; Connectors, or turn the leftover grants off here.
        </Notice>
      {% endif %}
      {% for scope_panel in connection.scopes %}
        {% if connection.scopes | length > 1 %}
          <h3 class="type-heading text-primary mt-6 mb-1">{{ scope_panel.heading }}</h3>
        {% endif %}
        {% for group in scope_panel.groups %}
          <p class="type-section text-tertiary mt-6 mb-1">{{ group.heading }}</p>
          <div class="flex flex-col">
            {% for toggle in group.toggles %}
            <div class="flex items-start justify-between gap-4 py-2 border-b border-subtle">
              <div class="min-w-0">
                <p class="type-body text-primary font-semibold flex items-center gap-2 min-w-0">
                  <span class="truncate">{{ toggle.label }}</span>
                  <code class="code-pill shrink-0">{{ toggle.permission }}</code>
                </p>
                {% if toggle.description %}
                  <p class="type-helper text-tertiary mt-0.5">{{ toggle.description }}</p>
                {% endif %}
              </div>
              <button type="button" role="switch"
                      aria-checked="{{ 'true' if toggle.is_granted else 'false' }}"
                      aria-label="{{ toggle.label }}"
                      class="perm-switch shrink-0 mt-0.5"
                      data-perm-kind="connector"
                      data-perm-scope="{{ scope_panel.scope }}"
                      data-perm-account="{{ connection.account }}"
                      data-perm-permission="{{ toggle.permission }}"
                      {% if not toggle.is_granted and not connection.is_connected %}disabled
                      data-tooltip="Connect this account before granting permissions."{% endif %}></button>
            </div>
            {% endfor %}
          </div>
        {% endfor %}
      {% endfor %}
    </section>
    {% endfor %}

    {# -- Add connection: the rest of the catalog, one browser sign-in away -- #}
    <section data-perm-panel="add-connection" class="{{ '' if _selected == 'add-connection' else 'hidden' }}">
      <h2 class="type-heading-lg text-primary mb-1">Add connection</h2>
      <p class="type-body text-secondary mb-4">
        Connect a service to grant agents access to it. Connecting signs you in; nothing is
        allowed until you turn permissions on.
      </p>
      {% if permissions_view.available_connections %}
        <div class="flex flex-col">
          {% for service in permissions_view.available_connections %}
          <div class="flex items-center justify-between gap-3 py-2 border-b border-subtle">
            <div class="flex items-center gap-2 min-w-0">
              {% if service.service_name in SERVICE_ICON_NAMES %}
                <img src="/_static/service_icons/{{ service.service_name }}.svg" alt="" class="w-4 h-4 shrink-0" />
              {% else %}
                <Icon16 name="box" extra="shrink-0 text-tertiary" />
              {% endif %}
              <span class="type-body text-primary truncate">{{ service.display_name }}</span>
            </div>
            <Button variant="secondary" size="md" class="perm-connect-btn shrink-0"
                    data-service-name={{ service.service_name }}>Connect</Button>
          </div>
          {% endfor %}
        </div>
      {% else %}
        <Notice variant="info">Every available service already has an account connected.</Notice>
      {% endif %}
    </section>

    {# -- Local files (file-sharing grants on this machine's host) -- #}
    <section data-perm-panel="local-files" class="hidden">
      <h2 class="type-heading-lg text-primary mb-1">Local files</h2>
      <p class="type-body text-secondary mb-4">
        Files and folders on this computer that agents in this machine can read or write. To share
        a new location, ask an agent to access it; revoked locations can be turned back on here.
      </p>
      {% if permissions_view.file_sharing_toggles %}
        <div class="flex flex-col">
          {% for toggle in permissions_view.file_sharing_toggles %}
          <div class="flex items-start justify-between gap-4 py-2 border-b border-subtle">
            <div class="min-w-0">
              <p class="type-body text-primary font-semibold flex items-center gap-2 min-w-0">
                <code class="code-pill truncate min-w-0" data-tooltip="{{ toggle.label }}">{{ toggle.label }}</code>
                <span class="type-helper text-secondary shrink-0 font-normal">{{ toggle.detail }}</span>
              </p>
            </div>
            <button type="button" role="switch"
                    aria-checked="{{ 'true' if toggle.is_granted else 'false' }}"
                    aria-label="Share {{ toggle.label }} ({{ toggle.detail }})"
                    class="perm-switch shrink-0 mt-0.5"
                    data-perm-kind="self"
                    data-perm-permission="{{ toggle.permission }}"
                    {% if not toggle.is_granted and not toggle.can_enable %}disabled
                    data-tooltip="This grant can't be re-enabled; ask the agent to request it again."{% endif %}></button>
          </div>
          {% endfor %}
        </div>
      {% else %}
        <Notice variant="info">No files are being shared with agents in this machine yet.</Notice>
      {% endif %}
    </section>

    {# -- Other machines (cross-workspace management verbs) -- #}
    <section data-perm-panel="other-machines" class="hidden">
      <h2 class="type-heading-lg text-primary mb-1">Other machines</h2>
      <p class="type-body text-secondary mb-4">
        What agents in this machine are allowed to do to your other machines (listing, creating,
        destroying, SSH, and more). To grant more, ask an agent to perform the operation.
      </p>
      {% if permissions_view.workspace_toggles %}
        <div class="flex flex-col">
          {% for toggle in permissions_view.workspace_toggles %}
          <div class="flex items-start justify-between gap-4 py-2 border-b border-subtle">
            <div class="min-w-0">
              <p class="type-body text-primary font-semibold flex items-center gap-2 min-w-0">
                <span class="truncate">{{ toggle.label }}</span>
                <span class="type-helper text-tertiary shrink-0 font-normal">on:</span>
                <span class="type-body text-secondary truncate font-normal">{{ toggle.detail }}</span>
              </p>
              {% if toggle.description %}
                <p class="type-helper text-tertiary mt-0.5">{{ toggle.description }}</p>
              {% endif %}
            </div>
            <button type="button" role="switch"
                    aria-checked="{{ 'true' if toggle.is_granted else 'false' }}"
                    aria-label="{{ toggle.label }} on {{ toggle.detail }}"
                    class="perm-switch shrink-0 mt-0.5"
                    data-perm-kind="self"
                    data-perm-permission="{{ toggle.permission }}"
                    {% if not toggle.is_granted and not toggle.can_enable %}disabled
                    data-tooltip="This grant can't be re-enabled; ask the agent to request it again."{% endif %}></button>
          </div>
          {% endfor %}
        </div>
      {% else %}
        <Notice variant="info">Agents in this machine can't manage your other machines yet.</Notice>
      {% endif %}
    </section>
  </div>
</div>
{% endif %}
